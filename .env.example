# Copy to .env.local and fill in. All are optional: without them the site still works, events
# queue in window.dataLayer, leads are accepted but not forwarded, and URLs fall back to the
# Vercel production domain (or localhost). On Vercel, set them under Settings → Environment
# Variables for the Production environment. See docs/seo-and-analytics.md.

# The live site's address, used for canonical URLs, the sitemap, robots.txt and share cards.
# No trailing slash, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Google Search Console ownership: the "content" value of the HTML-tag verification method.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership: the "content" value of its msvalidate.01 meta tag.
BING_SITE_VERIFICATION=

# Analytics: set ONE of these two.
# Google Tag Manager container (format GTM-XXXXXXX). Loads GTM, which reads the CRO events:
# cta_click, form_start, lead_submit, lead_error. Configure GA4 inside the container.
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 measurement id (format G-XXXXXXXXXX), loaded directly when there is no GTM
# container. The same CRO events are sent to GA4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Where /api/leads forwards each enquiry as JSON: a CRM, Zapier/Make webhook or email service.
LEAD_WEBHOOK_URL=
