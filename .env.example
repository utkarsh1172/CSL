# Copy to .env.local and fill in. Both are optional: without them the site still works,
# events queue in window.dataLayer and leads are accepted but not forwarded.

# Google Tag Manager container (format GTM-XXXXXXX). Loads GTM, which reads the CRO events:
# cta_click, form_start, lead_submit, lead_error.
NEXT_PUBLIC_GTM_ID=

# Where /api/leads forwards each enquiry as JSON: a CRM, Zapier/Make webhook or email service.
LEAD_WEBHOOK_URL=
